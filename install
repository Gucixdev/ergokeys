#!/usr/bin/env bash
# install - build ergokeys and install it for the current user: no arguments, no root.
# Binary to ~/.local/bin, layouts to ~/.local/share/ergokeys/layouts (the path is compiled into the binary, so the
# binary is built for the target). PREFIX=/usr/local (and sudo) installs system-wide; DESTDIR for packagers.
set -eu
cd "$(dirname "$(readlink -f "$0")")"
[ $# -eq 0 ] || { echo "install: takes no arguments (PREFIX=... in the environment changes the target)" >&2; exit 2; }
prefix=${PREFIX:-$HOME/.local}
make --quiet install PREFIX="$prefix" DESTDIR="${DESTDIR:-}"
echo "ergokeys installed in ${DESTDIR:-}$prefix/bin/ergokeys (layouts: ${DESTDIR:-}$prefix/share/ergokeys/layouts)"
case ":$PATH:" in
	*":${DESTDIR:-}$prefix/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $prefix/bin is not in PATH; add it to your shell profile" ;;
esac
